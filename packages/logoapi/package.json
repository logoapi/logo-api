{
  "name": "logoapi",
  "version": "0.3.1",
  "description": "Free company logo API: light and dark SVG logo URL by domain, stock ticker, ETF or crypto symbol, no API key. 54 ticker and coin logos bundled offline. Small install.",
  "keywords": [
    "logo",
    "logos",
    "logo-api",
    "company-logo",
    "company-logos",
    "brand-logo",
    "favicon",
    "svg",
    "stock-logo",
    "stock-logos",
    "ticker",
    "ticker-logos",
    "etf",
    "crypto-logo",
    "crypto-logos",
    "no-api-key",
    "clearbit-alternative",
    "offline"
  ],
  "homepage": "https://logoapi.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logoapi/logo-api.git",
    "directory": "packages/logoapi"
  },
  "bugs": {
    "url": "https://github.com/logoapi/logo-api/issues"
  },
  "license": "(MIT AND CC0-1.0)",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./index.json": "./index.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.json",
    "logos/",
    "NOTICE",
    "LICENSE-MIT",
    "llms.txt",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/prepack.js",
    "test": "node test.js"
  },
  "engines": {
    "node": ">=16.7"
  },
  "sideEffects": false
}
